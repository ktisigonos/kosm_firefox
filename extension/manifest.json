{
  "manifest_version": 2,
  "name": "Kosm",
  "version": "0.1.2",
  "description": "Shows pages in the colors and font of your kosmos, as kosm applies them.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kosm@ktisigonos",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "storage", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["darkreader.js", "sites.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": { "default_title": "Kosm", "default_popup": "popup.html" }
}
