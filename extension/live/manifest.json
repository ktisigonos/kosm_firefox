{
  "manifest_version": 2,
  "name": "Kosm Live",
  "version": "0.1.7",
  "description": "Shows pages in the colors and font of your kosmos, and sets the browser's prefs kosm wrote while it runs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kosm-live@ktisigonos",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "storage", "tabs", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["darkreader.js", "sites.js", "font.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "browser_action": { "default_title": "Kosm", "default_popup": "popup.html" },
  "experiment_apis": {
    "kosmLive": {
      "schema": "schema.json",
      "parent": { "scopes": ["addon_parent"], "script": "api.js", "paths": [["kosmLive"]] }
    }
  }
}
